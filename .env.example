# BIRD-Interact-ADK Configuration
# Copy this to .env and fill in your values

# ── LLMs ──
# LiteLLM model format: provider/model-name. Each role may use a different
# endpoint. Put a key directly in *_API_KEY or point *_API_KEY_FILE to a file
# containing either a raw key or a saved "Authorization: Bearer ..." curl call.
# Optional frozen system-agent preset. Conflicting explicit SYSTEM_AGENT_*
# model fields fail fast instead of silently overriding the preset.
# MODEL_PRESET=glm47_matched_32768
SYSTEM_AGENT_MODEL=openai/glm-5.2
SYSTEM_AGENT_API_BASE=https://open.bigmodel.cn/api/paas/v4
SYSTEM_AGENT_API_KEY=
SYSTEM_AGENT_API_KEY_FILE=../API/GLM_API.txt
# GLM-5.2 preserved/interleaved thinking + tool calling.
SYSTEM_AGENT_THINKING=enabled
SYSTEM_AGENT_REASONING_EFFORT=max
SYSTEM_AGENT_CLEAR_THINKING=false
SYSTEM_AGENT_MAX_TOKENS=65536
SYSTEM_AGENT_TEMPERATURE=0
# Omit for GLM-5.2 presets; glm47_matched_32768 supplies 0.95.
# SYSTEM_AGENT_TOP_P=0.95
SYSTEM_AGENT_TOOL_CHOICE=auto

# Valibra callback routing: research (default guardrails) or leaderboard
# (unconditional Official tool/cost/result/trajectory pass-through once issued).
VALIBRA_EXECUTION_PROFILE=research

# ── SQL Grounding Provider (optional, isolated from System Agent) ──
# Fill these only when running an explicitly authorized Grounding LLM stage.
# The adapter never falls back to SYSTEM_AGENT_* connection variables.
GROUNDING_UPDATER_MODE=
GROUNDING_MODEL_PRESET=
# SQL Grounding Provider and outer Updater timeout are both frozen at 600s.
GROUNDING_TIMEOUT_SECONDS=
GROUNDING_MAX_TOKENS=
# SQL Grounding 1.2: Structure+Mapping+Knowledge, plus at most one
# Clarification Patch per phase; two phases total maximum 8.
GROUNDING_MAX_CALLS_PER_TASK=
GROUNDING_PROMPT_SHA256=
GROUNDING_API_BASE=
GROUNDING_API_KEY=
GROUNDING_API_KEY_FILE=
GROUNDING_USE_BEARER_FOR_CUSTOM_BASE=

USER_SIM_MODEL=anthropic/claude-haiku-4-5-20251001
USER_SIM_API_BASE=https://api.gptsapi.net
USER_SIM_API_KEY=
USER_SIM_API_KEY_FILE=../API/gptsapi_API.txt
# Enable this for third-party Anthropic endpoints that require Authorization:
# Bearer instead of the official x-api-key header.
USER_SIM_USE_BEARER_FOR_CUSTOM_BASE=true
# Some Anthropic-compatible gateways enable hidden thinking by default. Disable
# it so the v2 simulator's 500/1024-token budgets contain visible protocol text.
USER_SIM_DISABLE_THINKING=true

# ── Dataset ──
# Options: "lite" (300 tasks, 18 DBs) or "full" (600 tasks, 26 DBs)
DATASET=lite

# ── PostgreSQL ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=root
PG_PASSWORD=123123

# ── Service Ports ──
SYSTEM_AGENT_PORT=6000
USER_SIM_PORT=6001
DB_ENV_PORT=6002

# ── Budget / Turns ──
# a-interact: budget = 6 + 2*ambiguities + 2*patience (per task)
# c-interact: max_turns = ambiguities + patience (per task)
PATIENCE=3
